# DEFYRA Environment Configuration Template
# Copy to .env.local for local development. Never commit real credentials.

# System & Brand
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="DEFYRA"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
COMPANY_LEGAL_NAME="MARKEET TECHNOLOGIES PRIVATE LIMITED"

# Database (PostgreSQL)
DATABASE_URL="postgresql://defyra_user:defyra_password@localhost:5432/defyra_db?schema=public"

# Cache & Queue (Redis)
REDIS_URL="redis://localhost:6379"

# Object Storage / Evidence Vault
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="defyra-evidence"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"

# Security & Sessions
SESSION_SECRET="change-this-to-a-secure-random-64-character-secret-in-production"
ENCRYPTION_KEY="change-this-to-a-32-byte-hex-key-for-data-at-rest-encryption"

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=10
