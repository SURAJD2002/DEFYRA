# DEFYRA Security Execution Engine Configuration
# Copy to .env and adjust variables as needed

ENGINE_HOST=127.0.0.1
ENGINE_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Secrets
CAPABILITY_SHARED_SECRET=defyra-execution-engine-shared-secret-key-32bytes!
MODULE_SIGNING_SECRET=defyra-module-signing-secret-key-32bytes!
SERVICE_BEARER_TOKEN=defyra-internal-service-token-secret-32bytes!

# Safety & Execution Boundaries
MAX_EXECUTION_TIMEOUT_SECONDS=120
MAX_STAGE_TIMEOUT_SECONDS=30
MAX_RESPONSE_SIZE_BYTES=5242880
MAX_REDIRECTS=3
BLOCK_DESTRUCTIVE_ACTIONS=true
DEFAULT_RATE_LIMIT_PER_MINUTE=60
